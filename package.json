{
  "name": "aivo",
  "private": true,
  "version": "0.2.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atlantis-mk/Aivo.git"
  },
  "packageManager": "pnpm@11.1.1",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "docs:trace": "node scripts/generate-traceability.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "work:new": "node scripts/work-new.mjs",
    "work:start": "node scripts/work-start.mjs",
    "work:finish": "node scripts/work-finish.mjs",
    "work:archive": "node scripts/archive-work.mjs",
    "scripts:test": "node --test scripts/*.test.mjs && node --test --experimental-strip-types apps/desktop/tests/*.test.ts && node --test examples/extensions/ui-test/server.test.mjs",
    "dev": "node scripts/dev.mjs",
    "build:core": "node scripts/build-core.mjs",
    "build": "npm --workspace @aivo/desktop run build",
    "lint": "npm --workspace @aivo/desktop run lint",
    "diagnostics": "npm run docs:check && npm run scripts:test && npm run test:core && npm run lint && npm run build",
    "package": "node scripts/package-desktop.mjs package",
    "package:mac": "node scripts/package-desktop.mjs package:mac",
    "package:win": "node scripts/package-desktop.mjs package:win",
    "package:linux": "node scripts/package-desktop.mjs package:linux",
    "smoke:release": "npm run build:core && node scripts/smoke-release.mjs",
    "dev:core": "cd core && go run ./cmd/aivo-core",
    "test:core": "cd core && go test ./..."
  }
}
